{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "contract:bundle": "npm run bundle -w @repo/api-contract",
    "contract:lint": "npm run lint -w @repo/api-contract",
    "generate": "npm run contract:bundle && npm run generate -w @repo/api"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.13.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
