# Копировать в .env в корне репозитория перед первым запуском
# (docker compose подхватывает .env из директории запуска, см. infra/docker-compose.yml).

POSTGRES_DB=gas_dashboard
POSTGRES_USER=gas_dashboard
POSTGRES_PASSWORD=gas_dashboard

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
